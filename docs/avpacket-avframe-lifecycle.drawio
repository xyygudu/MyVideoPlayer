<mxfile host="Electron" modified="2026-04-25T12:00:00.000Z" version="26.0.0">
  <diagram id="page-1" name="壳与数据的两层结构">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1"
                  page="1" pageScale="1" pageWidth="1169" pageHeight="827"
                  math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title1" value="&lt;b&gt;AVPacket / AVFrame 的两层结构：壳与数据分离&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;html=1;whiteSpace=wrap;align=center;" vertex="1" parent="1">
          <mxGeometry x="284" y="30" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- AVPacket 壳 container -->
        <mxCell id="shell" value="&lt;b&gt;AVPacket 壳（结构体）&lt;/b&gt;&lt;br&gt;&lt;i&gt;av_packet_alloc() 分配的是这个&lt;/i&gt;" style="swimlane;startSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;html=1;whiteSpace=wrap;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="120" width="340" height="280" as="geometry" />
        </mxCell>

        <!-- Fields inside shell -->
        <mxCell id="f_buf" value="&lt;b&gt;AVBufferRef *buf&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="shell">
          <mxGeometry x="30" y="70" width="280" height="36" as="geometry" />
        </mxCell>
        <mxCell id="f_data" value="uint8_t *data" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="shell">
          <mxGeometry x="30" y="116" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f_size" value="int size" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="shell">
          <mxGeometry x="30" y="156" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f_pts" value="int64_t pts, dts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="shell">
          <mxGeometry x="30" y="196" width="280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="f_idx" value="int stream_index" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;" vertex="1" parent="shell">
          <mxGeometry x="30" y="236" width="280" height="30" as="geometry" />
        </mxCell>

        <!-- AVBufferRef (data buffer) -->
        <mxCell id="bufref" value="&lt;b&gt;AVBufferRef&lt;/b&gt;&lt;br&gt;refcount = N&lt;br&gt;（原子操作，线程安全）" style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="150" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Actual data block -->
        <mxCell id="datablk" value="&lt;b&gt;实际数据&lt;/b&gt;&lt;br&gt;H.264 NAL / AAC / PCM / RGB ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="300" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Arrow: buf field → AVBufferRef -->
        <mxCell id="e_buf" value="指向" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6c8ebf;endArrow=block;endFill=1;" edge="1" source="f_buf" target="bufref" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrow: AVBufferRef → data block -->
        <mxCell id="e_data" value="管理" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#d6b656;endArrow=block;endFill=1;" edge="1" source="bufref" target="datablk" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend_title" value="&lt;b&gt;关键点&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1">
          <mxGeometry x="140" y="440" width="100" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg1" value="• alloc() 只分配壳（~80字节），不分配数据缓冲区" style="text;strokeColor=none;fillColor=none;fontSize=12;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1">
          <mxGeometry x="140" y="470" width="500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="• 数据缓冲区由 av_read_frame / avcodec_receive_frame 内部分配" style="text;strokeColor=none;fillColor=none;fontSize=12;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1">
          <mxGeometry x="140" y="494" width="500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="• move_ref 只搬壳里的指针（零拷贝），ref 则 refcount+1（共享数据）" style="text;strokeColor=none;fillColor=none;fontSize=12;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1">
          <mxGeometry x="140" y="518" width="500" height="24" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="• unref 释放本侧引用（refcount-1），refcount 到 0 时释放数据" style="text;strokeColor=none;fillColor=none;fontSize=12;html=1;whiteSpace=wrap;align=left;" vertex="1" parent="1">
          <mxGeometry x="140" y="542" width="500" height="24" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-2" name="AVPacket 数据流全景">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1"
                  page="1" pageScale="1" pageWidth="1600" pageHeight="900"
                  math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title2" value="&lt;b&gt;AVPacket 在 Demuxer → PacketQueue → Decoder 中的流转（零拷贝）&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;html=1;whiteSpace=wrap;align=center;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- === Demuxer Column === -->
        <mxCell id="demux_lane" value="&lt;b&gt;DemuxLoop&lt;/b&gt;&lt;br&gt;(demuxer.cc)" style="swimlane;startSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=0;html=1;whiteSpace=wrap;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="320" height="600" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="pkt = av_packet_alloc()&lt;br&gt;&lt;i&gt;分配空壳，循环外仅一次&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="demux_lane">
          <mxGeometry x="30" y="60" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="av_read_frame(ctx, pkt)&lt;br&gt;&lt;i&gt;pkt.buf → [数据A] ref=1&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="demux_lane">
          <mxGeometry x="30" y="140" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="queue→Push(pkt)&lt;br&gt;&lt;i&gt;内部 move_ref: 数据转移到队列壳&lt;br&gt;pkt 变空壳&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="demux_lane">
          <mxGeometry x="30" y="230" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="d4" value="av_packet_unref(pkt)&lt;br&gt;&lt;i&gt;pkt 已是空壳 → no-op&lt;br&gt;安全地进入下次循环&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="demux_lane">
          <mxGeometry x="30" y="340" width="260" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d5" value="&lt;i&gt;循环：回到 av_read_frame&lt;br&gt;复用同一个 pkt 壳&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="demux_lane">
          <mxGeometry x="30" y="440" width="260" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d6" value="av_packet_free(&amp;amp;pkt)&lt;br&gt;&lt;i&gt;循环结束，释放壳本身&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="demux_lane">
          <mxGeometry x="30" y="520" width="260" height="50" as="geometry" />
        </mxCell>

        <!-- Demux arrows -->
        <mxCell id="de1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="d1" target="d2" parent="demux_lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="d2" target="d3" parent="demux_lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="d3" target="d4" parent="demux_lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="d4" target="d5" parent="demux_lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de5" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" source="d5" target="d6" parent="demux_lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- === PacketQueue Column === -->
        <mxCell id="queue_lane" value="&lt;b&gt;PacketQueue&lt;/b&gt;&lt;br&gt;(packet_queue.cc)" style="swimlane;startSize=40;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=0;html=1;whiteSpace=wrap;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="80" width="320" height="600" as="geometry" />
        </mxCell>

        <mxCell id="q1" value="&lt;b&gt;Push:&lt;/b&gt;&lt;br&gt;copy = av_packet_alloc()&lt;br&gt;av_packet_move_ref(copy, pkt)&lt;br&gt;&lt;i&gt;copy.buf → [数据A], pkt 空壳&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="queue_lane">
          <mxGeometry x="20" y="100" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="q2" value="queue_.push(copy)&lt;br&gt;&lt;i&gt;队列拥有 copy 壳及数据&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="queue_lane">
          <mxGeometry x="20" y="220" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="q_data" value="&lt;b&gt;[数据A]&lt;/b&gt;&lt;br&gt;&lt;i&gt;始终在同一块内存&lt;br&gt;从未被拷贝！&lt;/i&gt;" style="shape=mxgraph.flowchart.database;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="queue_lane">
          <mxGeometry x="90" y="310" width="140" height="80" as="geometry" />
        </mxCell>

        <mxCell id="q3" value="&lt;b&gt;Pop:&lt;/b&gt;&lt;br&gt;front = queue_.front()&lt;br&gt;av_packet_move_ref(pkt, front)&lt;br&gt;av_packet_free(&amp;amp;front)&lt;br&gt;&lt;i&gt;pkt.buf → [数据A], front 释放&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="queue_lane">
          <mxGeometry x="20" y="430" width="280" height="100" as="geometry" />
        </mxCell>

        <mxCell id="qe1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="q1" target="q2" parent="queue_lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" source="q2" target="q_data" parent="queue_lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe3" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" source="q_data" target="q3" parent="queue_lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- === Decoder Column === -->
        <mxCell id="dec_lane" value="&lt;b&gt;DecodeLoop&lt;/b&gt;&lt;br&gt;(decoder.cc)" style="swimlane;startSize=40;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=0;html=1;whiteSpace=wrap;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="80" width="340" height="600" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="pkt = av_packet_alloc()&lt;br&gt;&lt;i&gt;分配空壳，循环外仅一次&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="dec_lane">
          <mxGeometry x="30" y="60" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="c2" value="packet_queue_→Pop(pkt)&lt;br&gt;&lt;i&gt;数据 move 到 pkt&lt;br&gt;pkt.buf → [数据A]&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="dec_lane">
          <mxGeometry x="30" y="150" width="280" height="60" as="geometry" />
        </mxCell>

        <mxCell id="c3" value="avcodec_send_packet(ctx, pkt)&lt;br&gt;&lt;i&gt;编解码器内部 addref → ref=2&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="dec_lane">
          <mxGeometry x="30" y="250" width="280" height="50" as="geometry" />
        </mxCell>

        <mxCell id="c4" value="av_packet_unref(pkt)&lt;br&gt;&lt;i&gt;ref=1, pkt 变空壳复用&lt;br&gt;[数据A] 仍存活（编解码器持有）&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="dec_lane">
          <mxGeometry x="30" y="340" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="c5" value="avcodec_receive_frame(ctx, frame)&lt;br&gt;&lt;i&gt;取出解码后的 AVFrame&lt;br&gt;编解码器释放 [数据A] ref → ref=0&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="dec_lane">
          <mxGeometry x="30" y="450" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="c1" target="c2" parent="dec_lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="c2" target="c3" parent="dec_lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce3" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="c3" target="c4" parent="dec_lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce4" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" source="c4" target="c5" parent="dec_lane">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cross-lane arrows -->
        <mxCell id="cross1" value="&lt;b&gt;Push&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#82b366;endArrow=block;endFill=1;fontSize=12;" edge="1" source="d3" target="q1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cross2" value="&lt;b&gt;Pop&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;strokeColor=#6c8ebf;endArrow=block;endFill=1;fontSize=12;" edge="1" source="q3" target="c2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="page-3" name="所有权转移全景图">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1"
                  tooltips="1" connect="1" arrows="1" fold="1"
                  page="1" pageScale="1" pageWidth="1600" pageHeight="900"
                  math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title3" value="&lt;b&gt;Demux → Decode → Render 全管线所有权转移（全程零拷贝）&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;html=1;whiteSpace=wrap;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- Stage boxes -->
        <mxCell id="s1" value="&lt;b&gt;av_read_frame&lt;/b&gt;&lt;br&gt;&lt;i&gt;demuxer 产出&lt;br&gt;压缩 packet&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s2" value="&lt;b&gt;PacketQueue&lt;/b&gt;&lt;br&gt;&lt;i&gt;线程安全缓冲&lt;br&gt;字节数限制 15MB&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="340" y="120" width="160" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s3" value="&lt;b&gt;avcodec_send_packet&lt;/b&gt;&lt;br&gt;&lt;i&gt;解码器消费&lt;br&gt;压缩 packet&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="620" y="120" width="170" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s4" value="&lt;b&gt;avcodec_receive_frame&lt;/b&gt;&lt;br&gt;&lt;i&gt;解码器产出&lt;br&gt;原始 frame&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="620" y="320" width="170" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s5" value="&lt;b&gt;FrameQueue&lt;/b&gt;&lt;br&gt;&lt;i&gt;线程安全缓冲&lt;br&gt;视频 3 帧 / 音频 9 帧&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="920" y="320" width="170" height="80" as="geometry" />
        </mxCell>

        <mxCell id="s6" value="&lt;b&gt;渲染 / 播放&lt;/b&gt;&lt;br&gt;&lt;i&gt;SDL 视频渲染&lt;br&gt;SDL 音频回调&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1210" y="320" width="160" height="80" as="geometry" />
        </mxCell>

        <!-- Arrows (top row: packet path) -->
        <mxCell id="a1" value="&lt;b&gt;move_ref&lt;/b&gt;&lt;br&gt;Push" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" source="s1" target="s2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;move_ref&lt;/b&gt;&lt;br&gt;Pop" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" source="s2" target="s3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Vertical arrow: send → receive -->
        <mxCell id="a3" value="&lt;i&gt;解码器内部&lt;br&gt;缓冲 + 解码&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;dashed=1;fontSize=11;" edge="1" source="s3" target="s4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Arrows (bottom row: frame path) -->
        <mxCell id="a4" value="&lt;b&gt;move_ref&lt;/b&gt;&lt;br&gt;Push" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" source="s4" target="s5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;move_ref&lt;/b&gt;&lt;br&gt;Pop" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;" edge="1" source="s5" target="s6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Data block annotation -->
        <mxCell id="data_note" value="&lt;b&gt;核心原则：数据不动，壳在动&lt;/b&gt;&lt;br&gt;&lt;br&gt;压缩数据（packet）和解压数据（frame）始终在&lt;br&gt;同一块内存中，只有 AVPacket/AVFrame 壳在不同&lt;br&gt;线程间通过 move_ref 零拷贝转移所有权。&lt;br&gt;&lt;br&gt;引用计数保证最后一个持有者释放时才回收内存。" style="shape=note;whiteSpace=wrap;html=1;size=20;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="280" width="420" height="160" as="geometry" />
        </mxCell>

        <!-- Thread labels -->
        <mxCell id="t_demux" value="&lt;b&gt;Demux 线程&lt;/b&gt;" style="text;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;html=1;fontColor=#82b366;" vertex="1" parent="1">
